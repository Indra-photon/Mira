# SEO Page Engine — environment variables
# Copy to .env for local runs. In GitHub Actions these come from repository
# secrets and variables (see docs/seo-engine/02-service-setup.md, section 7).
# Never commit .env or the Google service account JSON.

# ---------------------------------------------------------------------------
# Website
# ---------------------------------------------------------------------------
# Canonical site origin, no trailing slash. Used for sitemap fetch and IndexNow.
SITE_URL=https://www.craftui.space

# ---------------------------------------------------------------------------
# Google Search Console
# ---------------------------------------------------------------------------
# Absolute path to the service account JSON key (local). In Actions the
# workflow writes GOOGLE_SERVICE_ACCOUNT_JSON to a temp file and sets this.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/seo-engine-gsc.json
# Confirmed 2026-11-03: craftui.space is a Domain property in Search Console.
# Property exactly as GSC shows it: "sc-domain:example.com" for a domain
# property, or "https://www.example.com/" (with slash) for a URL-prefix property.
GSC_PROPERTY=sc-domain:craftui.space

# ---------------------------------------------------------------------------
# PostHog
# ---------------------------------------------------------------------------
# https://us.posthog.com or https://eu.posthog.com (or your self-hosted URL)
POSTHOG_HOST=https://us.posthog.com
# Numeric project ID from Settings → Project
POSTHOG_PROJECT_ID=12345
# Personal API key with query:read and project:read scopes
POSTHOG_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# DataForSEO
# ---------------------------------------------------------------------------
DATAFORSEO_LOGIN=you@example.com
# API password from Dashboard → API Access (not your account password)
DATAFORSEO_PASSWORD=xxxxxxxxxxxxxxxx
# Sandbox while building (free, fake data). Switch to
# https://api.dataforseo.com/v3 only after the first dry-run report is reviewed.
DATAFORSEO_BASE_URL=https://sandbox.dataforseo.com/v3
# 2840 = United States, 2826 = United Kingdom, 2356 = India
# Still to confirm: which market craftUI targets first
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model per task. Leave as-is unless you have a reason to change.
SEO_MODEL_FAST=claude-haiku-5-5
SEO_MODEL_BRIEF=claude-sonnet-5-5
SEO_MODEL_DRAFT=claude-opus-5-5

# ---------------------------------------------------------------------------
# Site repository (pull request target)
# ---------------------------------------------------------------------------
# owner/name of the website repo
SITE_REPO=craftUI012/craftUI-Pro
# Fine-grained PAT with Contents + Pull requests read/write on SITE_REPO only
SITE_REPO_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SITE_REPO_BASE_BRANCH=main
# Folder inside the site repo where drafts are written
SITE_CONTENT_DIR=content/seo-pages

# ---------------------------------------------------------------------------
# IndexNow (the key file public/<key>.txt lives in the site repo)
# ---------------------------------------------------------------------------
INDEXNOW_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Run controls
# ---------------------------------------------------------------------------
# 1 = run every step but skip Claude drafting and the pull request
SEO_DRY_RUN=1
# Hard caps; config/engine.json holds the defaults, these override per run
SEO_MAX_PAGES_PER_RUN=10
SEO_MAX_SERP_LOOKUPS_PER_RUN=400
# Stop the run if total Claude tokens (input + output) exceed this
SEO_MAX_TOKENS_PER_RUN=2000000
